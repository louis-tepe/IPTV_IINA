{
  "name": "IPTV Player (Enhanced)",
  "identifier": "com.iptv.iina-plugin",
  "version": "8.0.3",
  "description": "IPTV Player with catalog browser for movies, series, and live channels.",
  "author": {
    "name": "IPTV Plugin Developer"
  },
  "globalEntry": "global.js",
  "entry": "main.js",
  "permissions": [
    "file-system",
    "network-request",
    "show-osd",
    "show-alert"
  ],
  "allowedDomains": ["*"],
  "minIINAVersion": "1.4.1",
  "sidebarTab": {
    "name": "IPTV Browser"
  },
  "preferencesPage": "ui/connection.html",
  "preferenceDefaults": {
    "iptv_config": "",
    "iptv_play_request": "",
    "iptv_open_browser": "",
    "iptv_debug": false,
    "iptv_locale": "fr"
  }
}
