{
  "name": "IPTV Player (Enhanced)",
  "identifier": "com.iptv.iina-plugin",
  "version": "8.0.3",
  "description": "IPTV Player with catalog browser for movies, series, and live channels.",
  "author": {
    "name": "IPTV Plugin Developer"
  },
  "globalEntry": "global.js",
  "entry": "main.js",
  "permissions": [
    "file-system",
    "network-request",
    "show-osd",
    "show-alert",
    "video-overlay"
  ],
  "allowedDomains": ["*"],
  "minIINAVersion": "1.4.1",

  "preferencesPage": "ui/connection.html",
  "preferenceDefaults": {
    "iptv_config": "",
    "iptv_play_request": "",
    "iptv_browser_request": "",
    "iptv_debug": false,
    "iptv_locale": "fr",
    "iptv_server": "",
    "iptv_username": "",
    "iptv_password": "",
    "iptv_remember_me": "false",
    "iptv_history": "[]",
    "iptv_favorites": "{}",
    "iptv_resume_positions": "{}"
  }
}
